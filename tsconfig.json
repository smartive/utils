{
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "nodenext",
    "target": "esnext",
    "skipLibCheck": true,
    // next ships no package "exports" map, so NodeNext cannot resolve bare
    // subpaths like "next/headers". These paths are local type-check only;
    // emitted JS still imports 'next/headers' etc. and consumers resolve them
    // via their bundler (Next apps use moduleResolution: "bundler").
    "paths": {
      "next/cache": ["./node_modules/next/cache.d.ts"],
      "next/headers": ["./node_modules/next/headers.d.ts"],
      "next/navigation": ["./node_modules/next/navigation.d.ts"],
      "next/server": ["./node_modules/next/server.d.ts"]
    }
  },
  "include": ["./src/**/*"]
}
