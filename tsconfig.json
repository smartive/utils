{
  "compilerOptions": {
    "declaration": true,
    "outDir": "./dist/",
    "rootDir": "./src",
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitAny": true,
    "moduleResolution": "nodenext",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "module": "nodenext",
    "target": "es2022",
    "lib": ["es2022", "esnext.disposable"]
  },
  "include": ["./src/**/*"]
}
