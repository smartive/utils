{
  "name": "@smartive/utils",
  "version": "1.0.0",
  "description": "A set of general purpose utilities and helpers for web projects.",
  "type": "module",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "build": "tsc",
    "lint": "eslint src",
    "prettier": "prettier --check src"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "utils",
    "helpers"
  ],
  "author": "smartive AG",
  "license": "MIT",
  "repository": {
    "url": "git+https://github.com/smartive/utils.git",
    "type": "git"
  },
  "devDependencies": {
    "@smartive/eslint-config": "7.0.1",
    "@smartive/prettier-config": "3.1.2",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "typescript": "5.9.3"
  }
}
